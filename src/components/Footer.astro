---
export interface Props {
  buildDate: string;
}

const { buildDate } = Astro.props;
const human = new Date(buildDate).toUTCString();
---

<footer class="border-t border-border mt-12">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 font-mono text-xs text-fgMuted flex flex-wrap items-center gap-x-6 gap-y-2">
    <a href="https://github.com/erinlkolp" rel="me noopener" class="hover:underline">
      <span aria-hidden="true">[gh]</span> github
    </a>
    <a href="https://www.linkedin.com/in/erinlkolp/" rel="me noopener" class="hover:underline">
      <span aria-hidden="true">[in]</span> linkedin
    </a>
    <span class="ml-auto"># last refreshed: {human}</span>
  </div>
</footer>
