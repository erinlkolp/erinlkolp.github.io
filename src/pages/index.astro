---
import BaseLayout from "../layouts/BaseLayout.astro";
import PromptLine from "../components/PromptLine.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import { getProjects } from "../lib/projects";
import { getCollection } from "astro:content";

const projects = (await getProjects()).slice(0, 4);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout title="erinlkolp">
  <section class="mb-10">
    <PromptLine as="h1" command="whoami" />
    <p class="text-fg">
      I'm Erin Kolp — software engineer. I build tools, ship small experiments,
      and write about it sometimes.
    </p>
  </section>

  <section class="mb-10">
    <PromptLine as="h2" command="ls -1 projects/ | head -4" />
    {projects.length === 0 && (
      <p class="text-fgMuted">No featured projects yet.</p>
    )}
    {projects.map((p) => <ProjectCard project={p} />)}
    {projects.length > 0 && (
      <a href="/projects/" class="font-mono text-sm">$ cat /projects → see all</a>
    )}
  </section>

  <section class="mb-10">
    <PromptLine as="h2" command="ls -1 blog/ | head -3" />
    {posts.length === 0 && <p class="text-fgMuted">No posts yet.</p>}
    {posts.map((post) => <BlogPostCard post={post} />)}
    {posts.length > 0 && (
      <a href="/blog/" class="font-mono text-sm">$ cat /blog → all posts</a>
    )}
  </section>
</BaseLayout>
